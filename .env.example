# --- Supabase ---
# Get these from your project's "Connect" dialog (top of any project page
# in the dashboard, or Project Settings -> API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Secret key -- server-only, NEVER expose to the client or commit it.
# Replaces the old service_role key; bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# --- Database (Prisma) ---
# Also from the "Connect" dialog -> "ORMs" tab (pick Prisma) -- there's no
# separate Database settings page anymore. Use the "Transaction pooler"
# string for DATABASE_URL and the "Direct connection" string for
# DIRECT_URL (Prisma needs the direct one for migrations).
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres

# --- Payments (not wired up yet -- see lib/payments/provider.ts) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
